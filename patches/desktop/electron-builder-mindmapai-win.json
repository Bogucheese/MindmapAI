{
  "appId": "com.mindmapai.desktop",
  "productName": "MindmapAI",
  "copyright": "Copyright 2026 MindmapAI contributors; based on drawio (Apache-2.0, Copyright 2017-2026 draw.io Ltd)",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!dist{,/**}"
  ],
  "extraResources": [
    {
      "from": "../webapp/src/main/webapp/",
      "to": "webapp",
      "filter": [
        "**/*",
        "!**/WEB-INF{,/**}"
      ]
    }
  ],
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": false,
  "win": {
    "signExecutable": false,
    "target": [
      {
          "target": "nsis",
          "arch": [
            "x64"
          ]
      },
      {
        "target": "msi",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-windows-installer.${ext}",
  	"oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "createDesktopShortcut": false
  },
  "msi": {
    "artifactName": "${productName}-${version}.${ext}",
    "runAfterFinish": false,
    "createDesktopShortcut": false
  },
  "afterPack": "build/fuses.mjs",
  "msiProjectCreated": "build/msi-project-created.mjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
	  	"name": "MindmapAI Diagram",
	  	"description": "MindmapAI Diagram",
	  	"mimeType": "application/vnd.jgraph.mxfile",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  },
	  {
	  	"ext": ["mmd", "mermaid"],
	  	"name": "Mermaid Diagram",
	  	"description": "Mermaid Diagram",
	  	"mimeType": "text/vnd.mermaid",
	  	"role": "Editor"
	  }
  ]
}
